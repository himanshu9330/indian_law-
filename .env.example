# === LexAI — Bharat Legal Intelligence Configuration ===

# ── Primary LLM & Retrieval Keys ──────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
PINECONE_API_KEY=your_pinecone_api_key_here
SERPAPI_API_KEY=your_serpapi_api_key_here

# ── Low-Confidence / Fallback Indian Legal Reasoning (OpenRouter) ─────
# Get your API key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Recommended Qwen text models for Indian legal reasoning:
# - qwen/qwen-2.5-72b-instruct (Best accuracy, deep statutory knowledge)
# - qwen/qwen-2.5-32b-instruct (High speed, cost effective)
# - qwen/qwen-2.5-7b-instruct:free (100% Free on OpenRouter)
OPENROUTER_MODEL=qwen/qwen-2.5-72b-instruct

# ── Hugging Face Fallback (Optional) ───────────────────────────────────
HUGGINGFACE_API_KEY=your_huggingface_api_key_here
HUGGINGFACE_MODEL=law-ai/InLegalBERT

# ── Alibaba Qwen3-TTS Audio & Voice Readout ───────────────────────────
# Model: Alibaba Qwen3-TTS 1.7B parameter speech synthesis model
QWEN_TTS_MODEL=qwen/qwen3-tts-1.7b
ENABLE_TTS=true

# ── Pipeline Thresholds ───────────────────────────────────────────────
RAG_THRESHOLD=0.5
RAG_CONFIDENCE_THRESHOLD=0.5
RAG_TOP_K=3
GROQ_MODEL=llama-3.3-70b-versatile
